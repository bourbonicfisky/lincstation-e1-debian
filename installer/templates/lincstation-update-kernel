#!/usr/bin/python3
"""Build E1 Android-v2 boot A from Debian kernel/modules; B is never written."""
import argparse, fcntl, gzip, hashlib, json, os, re, shutil, stat, struct
import subprocess, tempfile, time, zlib
from pathlib import Path

ASSETS = Path('/usr/local/lib/lincstation')
STATE = Path('/var/lib/lincstation')
PLAN = json.loads(Path('/etc/lincstation-install.json').read_text())
CID = PLAN['emmc_cid']
UUID = PLAN['root_uuid']
BSHA = json.loads((ASSETS / 'boot-manifest.json').read_text())['recovery']['padded_sha256']
SIZE = 157286400

def require(ok, message):
    if not ok: raise SystemExit(message)

def run(*args):
    return subprocess.check_output(args, text=True).strip()

def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        while chunk := f.read(4194304): h.update(chunk)
    return h.hexdigest()

def slots(a, b):
    with open('/dev/mmcblk0p6', 'r+b', buffering=0) as f:
        f.seek(2048); old = f.read(512); data = bytearray(old[:32])
        require(data[:4] == b'\0AB0' and zlib.crc32(data[:28]) == struct.unpack('>I', data[28:])[0], 'Invalid A/B metadata')
        require(data[14] == 1, 'Recovery B not marked successful')
        data[8:12] = bytes(a); data[12:16] = bytes(b)
        data[28:] = struct.pack('>I', zlib.crc32(data[:28]))
        new = data + old[32:]
        f.seek(2048); require(f.write(new) == 512, 'Short metadata write'); os.fsync(f.fileno())
        f.seek(2048); require(f.read(512) == new, 'Metadata readback failed')

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('kernel', nargs='?', default=os.uname().release)
    p.add_argument('--install', action='store_true', help='Write verified image to boot A and arm a bounded trial; does not reboot')
    p.add_argument('--recovery', action='store_true', help='Select preserved recovery B for next boot; does not reboot')
    a = p.parse_args()
    require(os.geteuid() == 0, 'Run as root')
    os.umask(0o077); STATE.mkdir(exist_ok=True, parents=True)
    lock = open(STATE / 'update.lock', 'w'); fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    require(Path('/sys/block/mmcblk0/device/cid').read_text().strip() == CID, 'Wrong eMMC')
    require(run('findmnt', '-n', '-o', 'UUID', '/') == UUID, 'Wrong root filesystem')
    require('androidboot.slot_suffix=_a' in Path('/proc/cmdline').read_text(), 'Run from installed slot A')
    require(sha('/dev/mmcblk0p12') == BSHA, 'Recovery B hash mismatch')
    if a.recovery:
        require(not a.install, 'Choose recovery or install')
        slots([14, 0, 1, 0], [15, 0, 1, 0]); print('Recovery B selected. Run systemctl reboot when ready.'); return
    require(re.fullmatch(r'[A-Za-z0-9.+_-]+', a.kernel), 'Invalid kernel version')
    kernel = Path('/boot') / ('vmlinuz-' + a.kernel)
    modules = Path('/lib/modules') / a.kernel
    require(kernel.is_file() and (modules / 'modules.dep').is_file(), 'Install matching Debian kernel and modules first')
    with tempfile.TemporaryDirectory(prefix='build-', dir=STATE) as tmp:
        tmp = Path(tmp); root = tmp / 'root'; root.mkdir()
        subprocess.run(['tar', '--numeric-owner', '-xzf', str(ASSETS / 'initramfs-base.tar.gz'), '-C', str(root)], check=True)
        shutil.copy2(ASSETS / 'init', root / 'init')
        # The source is a text asset, so its filesystem mode is not authoritative.
        (root / 'init').chmod(0o755)
        subprocess.run(['/bin/sh', '-n', str(root / 'init')], check=True)
        require(os.access(root / 'bin/busybox', os.X_OK), 'Init interpreter is not executable')
        shutil.copytree(modules, root / 'lib/modules' / a.kernel, symlinks=True)
        (root / 'lib/modules').chmod(0o755)
        subprocess.run(['depmod', '-b', str(root), a.kernel], check=True)
        for metadata in (root / 'lib/modules' / a.kernel).glob('modules.*'):
            if metadata.is_file(): metadata.chmod(0o644)
        (root / 'www/sshd-test.log').unlink(missing_ok=True)
        entries = []
        for f in sorted(root.rglob('*')):
            name = str(f.relative_to(root)); st = f.lstat()
            if name in ('dev/null', 'dev/console'): continue
            data = os.readlink(f).encode() if f.is_symlink() else f.read_bytes() if stat.S_ISREG(st.st_mode) else b''
            entries.append((name, st.st_mode, data, os.major(st.st_rdev), os.minor(st.st_rdev)))
        entries += [('dev/console', stat.S_IFCHR | 0o600, b'', 5, 1), ('dev/null', stat.S_IFCHR | 0o666, b'', 1, 3), ('TRAILER!!!', 0, b'', 0, 0)]
        ram = tmp / 'initramfs.cpio.gz'
        with open(ram, 'wb') as raw, gzip.GzipFile(fileobj=raw, filename='', mode='wb', compresslevel=1, mtime=0) as z:
            for ino, (name, mode, data, major, minor) in enumerate(entries, 1):
                name = name.encode() + b'\0'
                fields = [ino, mode, 0, 0, 2 if stat.S_ISDIR(mode) else 1, 0, len(data), 0, 0, major, minor, len(name), 0]
                header = b'070701' + b''.join(f'{v:08x}'.encode() for v in fields) + name
                z.write(header + b'\0' * (-len(header) % 4) + data + b'\0' * (-len(data) % 4))
        image = tmp / 'boot.img'
        cmdline = f'console=ttyS2,1500000n8 earlycon=uart8250,mmio32,0xfe660000 root=UUID={UUID} rootfstype=ext4 rootwait rw panic=15 net.ifnames=0 rdinit=/init init=/sbin/init'
        subprocess.run(['python3', str(ASSETS / 'mkbootimg.py'), '--kernel', str(kernel), '--ramdisk', str(ram), '--second', str(ASSETS / 'resource.img'), '--dtb', str(ASSETS / 'board.dtb'), '--recovery_dtbo', str(ASSETS / 'recovery_dtbo'), '--header_version', '2', '--pagesize', '2048', '--base', '0x10000000', '--kernel_offset', '0x8000', '--ramdisk_offset', '0x01000000', '--second_offset', '0x00f00000', '--tags_offset', '0x100', '--dtb_offset', '0x01f00000', '--os_version', '12.0.0', '--os_patch_level', '2022-07', '--cmdline', cmdline, '--output', str(image)], check=True)
        data = image.read_bytes(); require(data[:8] == b'ANDROID!' and len(data) <= SIZE, 'Invalid/oversized boot image')
        dest = STATE / ('boot-' + a.kernel + '.img'); os.replace(image, dest)
        padded = data + b'\0' * (SIZE - len(data)); expected = hashlib.sha256(padded).hexdigest()
        record = dict(kernel=a.kernel, image=str(dest), image_bytes=len(data), image_sha256=sha(dest), padded_sha256=expected, recovery_b_sha256=BSHA, built_at=int(time.time()), installed=False, boot_id=Path("/proc/sys/kernel/random/boot_id").read_text().strip())
        if a.install:
            require(int(run('blockdev', '--getsize64', '/dev/mmcblk0p11')) == SIZE, 'Wrong boot A size')
            backup = STATE / ('boot-a-before-' + time.strftime('%Y%m%d-%H%M%S') + '.img')
            with open('/dev/mmcblk0p11', 'rb') as src, open(backup, 'wb') as out:
                shutil.copyfileobj(src, out); out.flush(); os.fsync(out.fileno())
            require(sha(backup) == sha('/dev/mmcblk0p11'), 'Backup verification failed')
            # Keep B preferred until the new A partition is fully verified.
            slots([0, 0, 0, 0], [15, 0, 1, 0])
            with open('/dev/mmcblk0p11', 'r+b', buffering=0) as f:
                require(f.write(padded) == SIZE, 'Short image write'); os.fsync(f.fileno())
            require(sha('/dev/mmcblk0p11') == expected, 'Boot A verification failed; B remains selected')
            slots([15, 2, 0, 0], [14, 0, 1, 0])
            record.update(installed=True, previous_boot=str(backup))
        dest.with_suffix('.json').write_text(json.dumps(record, indent=2) + '\n')
        print(json.dumps(record, indent=2))
        print('Reboot is manual. Recovery B is preserved.')

if __name__ == '__main__': main()
